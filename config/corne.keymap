#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        behaviors {
            hml: home_row_mod_left {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                flavor = "tap-preferred";
                require-prior-idle-ms = <150>;
                tapping-term-ms = <280>;
                quick-tap-ms = <175>;
                bindings = <&kp>, <&kp>;
            };
            hmr: home_row_mod_right {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                flavor = "tap-preferred";
                require-prior-idle-ms = <150>;
                tapping-term-ms = <280>;
                quick-tap-ms = <175>;
                bindings = <&kp>, <&kp>;
            };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        display-name = "Base";
                        bindings = <
   &kp TAB   &kp  Q       &kp  W       &kp  E      &kp  R      &kp T     /**/ &kp Y   &kp  U       &kp  I      &kp  O       &kp  P          &kp BSPC
   &kp LCTRL &hml LCTRL A &hml LSHFT S &hml LALT D &hml LCMD F &kp G     /**/ &kp H   &hmr RCMD J  &hmr RALT K &hmr RSHFT L &hmr RCTRL SEMI &kp SQT
   &kp LSHFT &kp  Z       &kp  X       &kp  C      &kp  V      &kp B     /**/ &kp N   &kp  M       &kp  COMMA  &kp  DOT     &kp  FSLH       &kp ESC
                                       &kp LGUI    &mo  1      &kp SPACE /**/ &kp RET &mo  2       &kp  RALT
                        >;
                };

                lower_layer {
// -----------------------------------------------------------------------------------------
// |  `   |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |  -  |
// |  ~   |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  =  |  +  |  _  |
// |      |     |  {  |  [  |  (  |     |   |     |  )  |  ]  |  }  |  \  | "|" |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        display-name = "Raise";
                        bindings = <
   &kp GRAVE &kp N1   &kp N2   &kp N3     &kp N4     &kp N5      &kp N6 &kp N7  &kp N8 &kp N9 &kp N0 &kp MINUS
   &kp TILDE &kp EXCL &kp AT   &kp HASH   &kp DLLR   &kp PRCNT   &kp CARET &kp AMPS &kp STAR        &kp EQUAL &kp PLUS &kp UNDER
   &none     &none    &kp LBRC &kp LBKT   &kp LPAR   &none       &none &kp RPAR  &kp RBKT        &kp RBRC &kp BSLH &kp PIPE
                    	       &kp LGUI &trans         &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |      | F1  | F2  | F3  | F4  | F5  |   | F6  | F7  | F8  | F9  | F10 | DEL  |
// |      |     | HOME| PGDN| PGUP| END |   | LFT | DWN | UP  | RGT |     |      |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        display-name = "Lower";
                        bindings = <
   &none      &kp F1       &kp F2       &kp F3       &kp F4       &kp F5       /**/ &kp F6   &kp F7   &kp F8 &kp F9    &kp F10 &kp DEL
   &none      &none        &kp HOME     &kp PG_UP    &kp PG_DN    &kp END      /**/ &kp LEFT &kp DOWN &kp UP &kp RIGHT &none   &none
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 /**/ &none    &none    &none  &none     &none   &none
                          	            &kp LGUI     &trans       &kp SPACE    /**/ &kp RET  &trans   &kp RALT
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };

                extra_3 {
                        status = "reserved";
                };
        };
};
